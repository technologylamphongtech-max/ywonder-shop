# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:../shop.db"

# Generate unique values for each deployment. Never commit real values.
AUTH_SECRET=""
MARKET_SECRET=""
PRODUCT_REFERRAL_SECRET=""

# Public Shop URL
MARKET_ORIGIN="http://localhost:3020"

# Optional integrations
SHOP_MAIL_BRIDGE_URL=""
SHOP_MAIL_BRIDGE_SECRET=""
VIETQR_MERCHANT_USER=""
VIETQR_MERCHANT_PASSWORD=""
VIETQR_TOKEN_SECRET=""
VIETQR_AUTO_VERIFY_ENABLED="false"
